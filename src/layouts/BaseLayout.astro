---
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Jim Toy — writing, notes, and resume." } = Astro.props;

const CAREER_START = new Date("1995-04-01T00:00:00Z");

function formatUptime(ms: number) {
	const totalSeconds = Math.floor(ms / 1000);
	const years = Math.floor(totalSeconds / (365.25 * 24 * 3600));
	const days = Math.floor((totalSeconds - years * 365.25 * 24 * 3600) / (24 * 3600));
	const hours = Math.floor((totalSeconds % (24 * 3600)) / 3600);
	const minutes = Math.floor((totalSeconds % 3600) / 60);
	const seconds = totalSeconds % 60;
	return `${years}y ${days}d ${String(hours).padStart(2, "0")}:${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`;
}

const initialUptime = formatUptime(Date.now() - CAREER_START.getTime());
const uptimeYears = Math.floor(
	(Date.now() - CAREER_START.getTime()) / (365.25 * 24 * 3600 * 1000),
);

const navItems = [
	{ href: "/", label: "home" },
	{ href: "/blog/", label: "writing" },
	{ href: "/notes/", label: "notes" },
	{ href: "/resume/", label: "resume" },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title} · Jim Toy</title>

		<script is:inline>
			(function () {
				const stored = localStorage.getItem("theme");
				if (stored) document.documentElement.setAttribute("data-theme", stored);
			})();
		</script>
	</head>
	<body class="min-h-screen font-serif flex flex-col">
		<header class="sticky top-0 z-10 border-b border-line bg-panel/95 backdrop-blur print:hidden">
			<div
				class="mx-auto max-w-3xl px-4 py-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 font-mono text-xs uppercase tracking-wide"
			>
				<div class="flex items-center gap-2 text-ash">
					<span class="text-signal" aria-hidden="true">●</span>
					<span>nominal</span>
					<span class="text-line" aria-hidden="true">/</span>
					<span aria-hidden="true" id="uptime">{initialUptime}</span>
					<span class="sr-only">
						{uptimeYears}+ years of professional software experience, and counting.
					</span>
				</div>
				<nav class="flex items-center gap-4">
					{
						navItems.map((item) => {
							const isActive =
								item.href === "/" ? currentPath === "/" : currentPath.startsWith(item.href);
							return (
								<a
									href={item.href}
									aria-current={isActive ? "page" : undefined}
									class={`hover:text-brass transition-colors ${isActive ? "text-brass" : "text-paper"}`}
								>
									{item.label}
								</a>
							);
						})
					}
					<button
						id="theme-toggle"
						type="button"
						class="text-paper hover:text-brass transition-colors"
						aria-label="Toggle color theme"
					>
						theme
					</button>
				</nav>
			</div>
		</header>

		<main class="flex-1 w-full mx-auto max-w-3xl px-4 py-10">
			<slot />
		</main>

		<footer
			class="border-t border-line font-mono text-xs uppercase tracking-wide text-ash print:hidden"
		>
			<div class="mx-auto max-w-3xl px-4 py-4 flex flex-wrap justify-between gap-2">
				<span>jimtoy.github.io · est. 1995</span>
				<a
					href="https://github.com/jimtoy/jimtoy.github.io"
					class="hover:text-brass transition-colors"
				>
					view source
				</a>
			</div>
		</footer>

		<script is:inline define:vars={{ careerStart: CAREER_START.toISOString() }}>
			const start = new Date(careerStart).getTime();
			const el = document.getElementById("uptime");
			const prefersReducedMotion = window.matchMedia(
				"(prefers-reduced-motion: reduce)",
			).matches;

			function format(ms) {
				const totalSeconds = Math.floor(ms / 1000);
				const years = Math.floor(totalSeconds / (365.25 * 24 * 3600));
				const days = Math.floor((totalSeconds - years * 365.25 * 24 * 3600) / (24 * 3600));
				const hours = Math.floor((totalSeconds % (24 * 3600)) / 3600);
				const minutes = Math.floor((totalSeconds % 3600) / 60);
				const seconds = totalSeconds % 60;
				return `${years}y ${days}d ${String(hours).padStart(2, "0")}:${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`;
			}

			function tick() {
				el.textContent = format(Date.now() - start);
			}

			if (el && !prefersReducedMotion) {
				tick();
				setInterval(tick, 1000);
			}

			const toggle = document.getElementById("theme-toggle");
			toggle?.addEventListener("click", () => {
				const current = document.documentElement.getAttribute("data-theme");
				const isLight =
					current === "light" ||
					(!current && window.matchMedia("(prefers-color-scheme: light)").matches);
				const next = isLight ? "dark" : "light";
				document.documentElement.setAttribute("data-theme", next);
				localStorage.setItem("theme", next);
			});
		</script>
	</body>
</html>
