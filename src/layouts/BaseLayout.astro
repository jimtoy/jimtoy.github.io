---
import "../styles/global.css";
import { CAREER_START, formatUptime } from "../lib/uptime";

interface Props {
	title: string;
	description?: string;
	type?: "website" | "article";
}

const {
	title,
	description = "Jim Toy — writing and resume.",
	type = "website",
} = Astro.props;

const pageTitle = `${title} · Jim Toy`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const initialUptime = formatUptime(Date.now() - CAREER_START.getTime());
const uptimeYears = Math.floor(
	(Date.now() - CAREER_START.getTime()) / (365.25 * 24 * 3600 * 1000),
);

const navItems = [
	{ href: "/", label: "home" },
	{ href: "/blog/", label: "writing" },
	{ href: "/resume/", label: "resume" },
];

const currentPath = Astro.url.pathname;
const isDev = import.meta.env.DEV;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="alternate" type="application/rss+xml" title="Jim Toy — Writing" href="/blog/rss.xml" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<title>{pageTitle}</title>

		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="Jim Toy" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:site" content="@jim_toy" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />

		{
			isDev && (
				<script is:inline>
					(function () {
						const stored = localStorage.getItem("theme");
						if (stored) document.documentElement.setAttribute("data-theme", stored);
					})();
				</script>
			)
		}
	</head>
	<body class="min-h-screen font-serif flex flex-col">
		<header class="sticky top-0 z-10 border-b border-line bg-panel/95 backdrop-blur print:hidden">
			<div
				class="mx-auto max-w-3xl px-4 py-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 font-mono text-xs uppercase tracking-wide"
			>
				<div class="flex items-center gap-2 text-ash">
					<span class="text-signal" aria-hidden="true">●</span>
					<span>nominal</span>
					<span class="text-line" aria-hidden="true">/</span>
					<span aria-hidden="true" id="uptime" data-career-start={CAREER_START.toISOString()}>{initialUptime}</span>
					<span class="sr-only">
						{uptimeYears}+ years of professional software experience, and counting.
					</span>
				</div>
				<nav class="flex items-center gap-4">
					{
						navItems.map((item) => {
							const isActive =
								item.href === "/" ? currentPath === "/" : currentPath.startsWith(item.href);
							return (
								<a
									href={item.href}
									aria-current={isActive ? "page" : undefined}
									class={`hover:text-brass transition-colors ${isActive ? "text-brass" : "text-paper"}`}
								>
									{item.label}
								</a>
							);
						})
					}
					{
						isDev && (
							<button
								id="theme-toggle"
								type="button"
								class="text-paper hover:text-brass transition-colors"
								aria-label="Toggle color theme (dev only)"
							>
								theme
							</button>
						)
					}
				</nav>
			</div>
		</header>

		<main class="flex-1 w-full mx-auto max-w-3xl px-4 py-10">
			<slot />
		</main>

		<footer
			class="border-t border-line font-mono text-xs uppercase tracking-wide text-ash print:hidden"
		>
			<div class="mx-auto max-w-3xl px-4 py-4 flex flex-wrap items-center justify-between gap-2">
				<span>jimtoy.github.io · est. 1995</span>
				<div class="flex items-center gap-4">
					<a
						href="https://www.linkedin.com/in/jim-toy-591b051/"
						aria-label="LinkedIn"
						class="hover:text-brass transition-colors"
					>
						<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
							<path d="M4.98 3.5a2.5 2.5 0 1 1 0 5.001 2.5 2.5 0 0 1 0-5.001ZM3 9.5h4V21H3V9.5Zm7 0h3.8v1.57h.05c.53-.98 1.83-2.02 3.77-2.02 4.03 0 4.78 2.55 4.78 5.87V21h-4v-5.5c0-1.31-.02-3-1.85-3-1.85 0-2.13 1.4-2.13 2.9V21h-4V9.5Z" />
						</svg>
					</a>
					<a
						href="https://x.com/jim_toy"
						aria-label="X (Twitter)"
						class="hover:text-brass transition-colors"
					>
						<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
							<path d="M13.9 10.72 21.2 2.5h-1.73l-6.34 7.14L8.1 2.5H2.3l7.66 10.94L2.3 21.5h1.73l6.7-7.55 5.34 7.55h5.8l-7.97-10.78Zm-2.37 2.67-.78-1.1L4.55 3.75h2.66l4.98 6.98.78 1.1 6.48 9.08h-2.66l-5.26-7.52Z" />
						</svg>
					</a>
					<a
						href="https://github.com/jimtoy/jimtoy.github.io"
						class="hover:text-brass transition-colors"
					>
						view source
					</a>
				</div>
			</div>
		</footer>

		<script>
			import { formatUptime } from "../lib/uptime";

			const el = document.getElementById("uptime");
			const start = new Date(el?.dataset.careerStart ?? 0).getTime();
			const prefersReducedMotion = window.matchMedia(
				"(prefers-reduced-motion: reduce)",
			).matches;

			function tick() {
				el.textContent = formatUptime(Date.now() - start);
			}

			if (el && !prefersReducedMotion) {
				tick();
				setInterval(tick, 1000);
			}

			const toggle = document.getElementById("theme-toggle");
			toggle?.addEventListener("click", () => {
				const current = document.documentElement.getAttribute("data-theme");
				const isLight =
					current === "light" ||
					(!current && window.matchMedia("(prefers-color-scheme: light)").matches);
				const next = isLight ? "dark" : "light";
				document.documentElement.setAttribute("data-theme", next);
				localStorage.setItem("theme", next);
			});
		</script>
	</body>
</html>
