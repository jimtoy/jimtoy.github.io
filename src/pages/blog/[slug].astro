---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts, formatDate } from "../../lib/posts";

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description} type="article">
	<div class="font-mono text-xs uppercase tracking-wide text-ash">
		{formatDate(post.data.date)}
	</div>
	<h1 class="mt-2 font-mono text-2xl text-brass tracking-tight">{post.data.title}</h1>
	<div class="prose prose-lg mt-8 max-w-none">
		<Content />
	</div>
</BaseLayout>
