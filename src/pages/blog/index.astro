---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="Writing" description="Long-form writing from Jim Toy.">
	<div class="flex items-baseline justify-between gap-4">
		<h1 class="font-mono text-2xl text-brass tracking-tight">Writing</h1>
		<a
			href="/blog/rss.xml"
			class="font-mono text-xs uppercase tracking-wide text-ash hover:text-brass transition-colors"
		>
			rss
		</a>
	</div>

	{posts.length === 0 && <p class="mt-4 text-ash">Nothing published yet.</p>}

	<ul class="mt-8 divide-y divide-line">
		{
			posts.map((post) => (
				<li class="py-6 first:pt-0">
					<a href={`/blog/${post.id}/`} class="group block">
						<div class="font-mono text-xs uppercase tracking-wide text-ash">
							{post.data.date.toLocaleDateString("en-US", {
								year: "numeric",
								month: "long",
								day: "numeric",
								timeZone: "UTC",
							})}
						</div>
						<h2 class="mt-1 text-lg group-hover:text-brass transition-colors">
							{post.data.title}
						</h2>
						{post.data.description && <p class="mt-1 text-ash">{post.data.description}</p>}
					</a>
				</li>
			))
		}
	</ul>
</BaseLayout>
