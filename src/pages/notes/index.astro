---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { formatDateTime } from "../../lib/posts";

const notes = (await getCollection("notes")).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const rendered = await Promise.all(
	notes.map(async (note) => ({ note, Content: (await render(note)).Content })),
);
---

<BaseLayout title="Notes" description="Short-form notes from Jim Toy.">
	<h1 class="font-mono text-2xl text-brass tracking-tight">Notes</h1>

	{notes.length === 0 && <p class="mt-4 text-ash">Nothing posted yet.</p>}

	<ul class="mt-8 divide-y divide-line">
		{
			rendered.map(({ note, Content }) => (
				<li class="py-6 first:pt-0">
					<div class="font-mono text-xs uppercase tracking-wide text-ash">
						{formatDateTime(note.data.date)}
					</div>
					{note.data.title && <h2 class="mt-1 text-lg">{note.data.title}</h2>}
					<div class="prose mt-2 max-w-none">
						<Content />
					</div>
				</li>
			))
		}
	</ul>
</BaseLayout>
